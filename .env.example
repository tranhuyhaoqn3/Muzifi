# Server Configuration
PORT=3000
HOST=0.0.0.0

# Security (Single user password)
APP_PASSWORD=admin123
SESSION_SECRET=change_this_to_a_secure_random_string_in_production
DISABLE_AUTH=false

# Storage paths (relative or absolute)
DATA_DIR=./data

# Binary paths (leave default if available in system PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
